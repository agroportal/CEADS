<https://w3id.org/agrisemantics/MIO/contributionMilkBE> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <https://w3id.org/agrisemantics/MIO/MilkInvoice> ;
                                                        rdfs:range xsd:float ;
                                                        rdfs:label "MilkBE contribution"@en ;
                                                        skos:definition "The monetary amount deducted from the milk payment as a contribution to MilkBE"@en .


###  https://w3id.org/agrisemantics/MIO/contributionSanitaryFund
<https://w3id.org/agrisemantics/MIO/contributionSanitaryFund> rdf:type owl:DatatypeProperty ;
                                                              rdfs:domain <https://w3id.org/agrisemantics/MIO/MilkInvoice> ;
                                                              rdfs:range xsd:float ;
                                                              rdfs:label "contribution to sanitary fund"@en ;
                                                              skos:definition "The monetary amount deducted from the milk payment as a contribution to the sanitary fund during the reporting period"@en .


###  https://w3id.org/agrisemantics/MIO/cooperativeRepayments
<https://w3id.org/agrisemantics/MIO/cooperativeRepayments> rdf:type owl:DatatypeProperty ;
                                                           rdfs:label "cooperative repayments"@en ;
                                                           skos:definition "The total monetary amount of supplementary payments or repayments made by the cooperative to the milk supplier"@en .


###  https://w3id.org/agrisemantics/MIO/fatAmount
<https://w3id.org/agrisemantics/MIO/fatAmount> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <https://w3id.org/agrisemantics/MIO/MilkInvoice> ;
                                               rdfs:range xsd:float ;
                                               rdfs:label "fat amount"@en ;
                                               skos:definition "The total quantity of butterfat contained in the delivered milk, expressed in kilograms"@en .


###  https://w3id.org/agrisemantics/MIO/fatPrice
<https://w3id.org/agrisemantics/MIO/fatPrice> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://w3id.org/agrisemantics/MIO/MilkInvoice> ;
                                              rdfs:range xsd:float ;
                                              rdfs:label "fat price"@en ;
                                              skos:definition "The unit price applied to butterfat content, expressed as the monetary amount per 100 kilograms of butterfat, excluding value-added tax (VAT)."@en .


