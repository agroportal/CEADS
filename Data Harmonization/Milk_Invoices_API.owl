#################################################################
#    Classes
#################################################################

###  http://xmlns.com/foaf/0.1/Agent
foaf:Agent rdf:type owl:Class ;
           rdfs:label "Agent"@en .


###  https://schema.org/Invoice
sdo:Invoice rdf:type owl:Class ;
            rdfs:label "Invoice"@en .


###  https://w3id.org/agrisemantics/MIO/MilkInvoice
<https://w3id.org/agrisemantics/MIO/MilkInvoice> rdf:type owl:Class ;
                                                 rdfs:subClassOf sdo:Invoice ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/agrisemantics/MIO/hasSupplier> ;
                                                                   owl:someValuesFrom <https://w3id.org/agrisemantics/MIO/MilkSupplier>
                                                                 ] ;
                                                 skos:definition "A document or record representing the financial settlement for milk supplied during a given billing period."@en ;
                                                 skos:prefLabel "Milk invoice"@en .


###  https://w3id.org/agrisemantics/MIO/MilkSupplier
<https://w3id.org/agrisemantics/MIO/MilkSupplier> rdf:type owl:Class ;
                                                  rdfs:subClassOf foaf:Agent ;
                                                  skos:definition "An agent, typically a farm or producer, that supplies milk and is identified by a supplier number in the invoicing system."@en ;
                                                  skos:prefLabel "Milk supplier"@en .


