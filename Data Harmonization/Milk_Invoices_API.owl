                                                   rdfs:range xsd:float ;
                                                   rdfs:label "protein amount"@en ;
                                                   skos:definition "The total quantity of protein contained in the delivered milk, expressed in kilograms"@en .


###  https://w3id.org/agrisemantics/MIO/proteinPrice
<https://w3id.org/agrisemantics/MIO/proteinPrice> rdf:type owl:DatatypeProperty ;
