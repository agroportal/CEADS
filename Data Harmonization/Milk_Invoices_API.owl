                                                  rdfs:range xsd:float ;
                                                  rdfs:label "VLAM contribution"@en ;
                                                  skos:definition "The monetary amount deducted from the milk payment as a levy or contribution to the Flemish Centre for Agricultural and Fisheries Marketing (VLAM)"@en .


