                                           rdfs:range xsd:gMonth ;
                                           skos:definition "The month of the billing period."@en ;
                                           skos:prefLabel "month"@en .


###  https://w3id.org/agrisemantics/MIO/proteinAmount
<https://w3id.org/agrisemantics/MIO/proteinAmount> rdf:type owl:DatatypeProperty ;
