                                                   rdfs:range xsd:float ;
                                                   rdfs:label "other deductions"@en ;
                                                   skos:definition "The total monetary amount of other deductions withheld from the milk payment that are not otherwise specifically categorized"@en .


###  https://w3id.org/agrisemantics/MIO/holdingsVLAM
<https://w3id.org/agrisemantics/MIO/holdingsVLAM> rdf:type owl:DatatypeProperty ;
